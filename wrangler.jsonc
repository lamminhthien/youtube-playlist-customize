{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "youtube-playlist-customize",
  "compatibility_date": "2026-08-08",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "exclude": [
      "node_modules/**",
      "tests/**",
      "package.json",
      "package-lock.json",
      "bun.lockb",
      "wrangler.jsonc",
      ".git/**",
      ".gitignore",
      ".gitattributes",
      "google-apps-script-youtube-api-guide.md"
    ]
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
