{
  "name": "youtube-playlist-customize",
  "version": "1.0.0",
  "description": "LMT YouTube Playlist feed viewer (vanilla JS + ESM).",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "vercel dev --listen 3010 --yes",
    "test": "node --test tests/*.test.js",
    "bump-cache": "node scripts/bump-cache-version.mjs",
    "verify-channels": "node scripts/verify-channels.mjs",
    "predeploy": "node scripts/verify-channels.mjs && node scripts/bump-cache-version.mjs",
    "deploy": "wrangler deploy",
    "deploy:vercel": "node scripts/verify-channels.mjs && node scripts/bump-cache-version.mjs && vercel --prod",
    "preview": "wrangler dev"
  },
  "devDependencies": {
    "vercel": "^59.10.0",
    "wrangler": "^4.120.0"
  },
  "dependencies": {
    "youtubei.js": "^18.0.0"
  }
}
