{
  "name": "youtube-playlist-customize",
  "version": "1.0.0",
  "description": "LMT YouTube Playlist feed viewer (vanilla JS + ESM).",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "npm run build:css && vercel dev --listen 3010 --yes",
    "test": "node --test tests/*.test.js",
    "bump-cache": "node scripts/bump-cache-version.mjs",
    "verify-channels": "node scripts/verify-channels.mjs",
    "predeploy": "npm test && npm run build:css && node scripts/verify-channels.mjs && node scripts/bump-cache-version.mjs",
    "deploy": "wrangler deploy",
    "deploy:vercel": "npm test && node scripts/verify-channels.mjs && node scripts/bump-cache-version.mjs && vercel --prod",
    "preview": "wrangler dev",
    "build:css": "./node_modules/.bin/postcss src/styles.css -o styles.css",
    "watch:css": "./node_modules/.bin/postcss src/styles.css -o styles.css --watch"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "autoprefixer": "^10.5.4",
    "postcss": "^8.5.26",
    "postcss-cli": "^11.0.1",
    "tailwindcss": "^4.3.3",
    "vercel": "^59.10.0",
    "wrangler": "^4.120.0"
  },
  "dependencies": {
    "@octokit/rest": "^21.0.0",
    "youtubei.js": "^18.0.0"
  }
}
