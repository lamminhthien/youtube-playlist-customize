# GitHub Issue Reporting Configuration
# Create a Fine-grained Personal Access Token at https://github.com/settings/tokens
# Required permissions: Repository permissions -> Issues: Read & Write
GITHUB_PAT=github_pat_xxxxxxxxxxxx

# GitHub repository owner (username or organization)
GITHUB_OWNER=your-github-username

# GitHub repository name
GITHUB_REPO_NAME=your-repo-name

# Ollama AI Chatbot (issue #9) — supports Ollama Cloud + local
# For Ollama Cloud (recommended): create API key at https://ollama.com/settings/keys
#   OLLAMA_BASE_URL=https://ollama.com
#   OLLAMA_API_KEY=your_ollama_cloud_api_key
#   OLLAMA_MODEL=gpt-oss:20b   (or gpt-oss:120b, deepseek-v3.1:671b-cloud, etc.)
# For local Ollama: OLLAMA_BASE_URL=http://localhost:11434  OLLAMA_MODEL=llama3.1
OLLAMA_BASE_URL=https://ollama.com
# Default model — cloud default gpt-oss:20b, local default llama3.1
OLLAMA_MODEL=gpt-oss:20b
# API key for Ollama Cloud (Bearer token). Leave empty for local.
OLLAMA_API_KEY=